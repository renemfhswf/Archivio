{
  "name": "archivio",
  "version": "0.1.0",
  "description": "Archivio – große Dateimengen sicher sortieren, prüfen und archivieren.",
  "main": "./out/main/index.js",
  "author": "Rene",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/renemfhswf/Archivio",
  "repository": {
    "type": "git",
    "url": "https://github.com/renemfhswf/Archivio.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:only": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:win:dir": "npm run build && electron-builder --win --dir --publish never",
    "icon": "python3 scripts/generate-icon.py"
  },
  "dependencies": {
    "docx-preview": "^0.3.3",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
